    {
      "parameters": {
        "jsCode": "// Arma el texto de la alerta (HTML de Telegram) y las opciones según lo que hizo el monitor.\nconst e = $input.first().json;\nconst resultado = String($('Aviso del monitor').first().json.body.resultado || '');\n\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst corto = (h) => (h ? h.slice(0, 16) + '…' : '—');\nconst iconos = { MODIFICADO: '✏️', CREADO: '🆕', ELIMINADO: '🗑', MOVIDO: '📦', PERMISOS: '🔐' };\n\nconst autorizado = resultado === 'AUTORIZADO' || e.ventana_id !== null;\nlet estado;\nlet opciones;\nif (autorizado) {\n  estado = `🛠 Cambio autorizado por la ventana de mantenimiento #${e.ventana_id ?? '?'}: no se restauró. ¿Lo pasás a la baseline?`;\n  opciones = [['ACEPTAR', 'Pasar a la baseline'], ['RESTAURAR', 'Restaurar']];\n} else if (resultado === 'PENDIENTE') {\n  estado = '⏸ Pendiente de aprobación: el archivo sigue alterado.';\n  opciones = [['RESTAURAR', 'Restaurar'], ['ACEPTAR', 'Aceptar cambio']];\n} else if (resultado === 'RESTAURADO') {\n  estado = '✅ Restaurado automáticamente desde la bóveda.';\n  opciones = [['INCIDENTE', 'Fue un incidente'], ['AUTORIZADO', 'Era un cambio autorizado']];\n} else if (resultado === 'CREADO') {\n  estado = '🧳 Archivo fuera de la baseline: se movió a cuarentena.';\n  opciones = [['INCIDENTE', 'Fue un incidente'], ['AUTORIZADO', 'Era un cambio autorizado']];\n} else if (resultado === 'NO_RESTAURADO') {\n  estado = '⚠️ NO se pudo restaurar (bóveda no confiable o faltan permisos). Requiere revisión manual.';\n  opciones = [['INCIDENTE', 'Registrar como incidente'], ['AUTORIZADO', 'Era un cambio autorizado']];\n} else {\n  estado = `Resultado informado por el monitor: ${esc(resultado) || 'desconocido'}.`;\n  opciones = [];\n}\n\nconst lineas = [\n  `${iconos[e.evento] || '❗'} <b>FIM: ${esc(e.evento)}</b> · ${esc(e.nombre_archivo)}`,\n  `<code>${esc(e.ruta_completa)}</code>`,\n  `🕒 ${esc(e.fecha)} · evento #${e.evento_id}`,\n  `Hash anterior: <code>${esc(corto(e.hash_anterior))}</code>`,\n  `Hash nuevo: <code>${esc(corto(e.hash_sha256))}</code>`,\n];\nif (e.evento === 'PERMISOS') lineas.push(`Permisos/propietario actuales: ${esc(e.permisos)} / uid ${esc(e.owner_archivo)}`);\nif (e.ruta_cuarentena) lineas.push(`Cuarentena: <code>${esc(e.ruta_cuarentena)}</code>`);\nlineas.push(Number(e.eventos_previos) > 0\n  ? `Historial: ${e.eventos_previos} evento(s) anterior(es) en este archivo, el último el ${esc(e.ultimo_previo)}.`\n  : 'Historial: es el primer evento de este archivo.');\nlineas.push('', estado);\n\n// Telegram acepta hasta 4096 caracteres: el diff se recorta para que el mensaje entre completo\nconst LIMITE_TELEGRAM = 4000;\nlet diff = esc(e.diff || '');\nlet recortado = !!e.diff_truncado;\n\n// Links locales para decidir desde la PC (se arman con localhost aunque n8n tenga una URL pública)\nconst datos = $('Datos de la ejecución').first().json;\nconst urlEspera = String(datos.resume_url).replace(/^https?:\\/\\/[^/]+/, String(datos.url_local).replace(/\\/+$/, ''));\nconst separador = urlEspera.includes('?') ? '&' : '?';\nconst links = opciones.map(([decision, etiqueta]) => {\n  const u = `${urlEspera}${separador}decision=${encodeURIComponent(decision)}`;\n  return `• <a href=\"${esc(u)}\">${esc(etiqueta)}</a>`;\n});\nconst pie = links.length ? ['', '<b>Decidir desde la PC</b> (links válidos 24 h):', ...links] : [];\nconst resto = [...lineas, ...pie].join('\\n').length + 40;\nif (resto + diff.length > LIMITE_TELEGRAM) {\n  diff = diff.slice(0, Math.max(0, LIMITE_TELEGRAM - resto)).replace(/&[a-z]*$/, '');\n  recortado = true;\n}\nif (diff) lineas.push('', `<pre>${diff}${recortado ? '\\n… (recortado; completo en la BD)' : ''}</pre>`);\nlineas.push(...pie);\n\nreturn [{ json: {\n  evento_id: e.evento_id,\n  evento: e.evento,\n  nombre_archivo: e.nombre_archivo,\n  autorizado,\n  tipo_aviso: autorizado ? 'informativo' : 'alerta',\n  opciones: opciones.map(([decision, etiqueta]) => ({ decision, etiqueta })),\n  texto: lineas.join('\\n'),\n} }];\n"
      },
