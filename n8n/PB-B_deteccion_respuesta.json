    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT e.id AS evento_id, e.evento, e.nombre_archivo, e.ruta_completa,\n       e.hash_anterior, e.hash_sha256, e.ruta_cuarentena, e.permisos, e.owner_archivo,\n       left(coalesce(e.detalles_diff, ''), 3000) AS diff,\n       length(coalesce(e.detalles_diff, '')) > 3000 AS diff_truncado,\n       to_char(e.fecha_registro AT TIME ZONE 'America/Argentina/Mendoza', 'DD/MM/YYYY HH24:MI:SS') AS fecha,\n       (SELECT count(*) FROM registros_archivos h\n         WHERE h.ruta_completa = e.ruta_completa AND h.evento IN ('MODIFICADO', 'CREADO', 'ELIMINADO', 'MOVIDO', 'PERMISOS') AND h.id < e.id) AS eventos_previos,\n       (SELECT to_char(max(h.fecha_registro) AT TIME ZONE 'America/Argentina/Mendoza', 'DD/MM/YYYY HH24:MI') FROM registros_archivos h\n         WHERE h.ruta_completa = e.ruta_completa AND h.evento IN ('MODIFICADO', 'CREADO', 'ELIMINADO', 'MOVIDO', 'PERMISOS') AND h.id < e.id) AS ultimo_previo,\n       (SELECT v.id FROM ventanas_mantenimiento v\n         WHERE e.fecha_registro >= v.desde AND e.fecha_registro < v.hasta\n           AND (e.ruta_completa = v.ruta OR starts_with(e.ruta_completa, rtrim(v.ruta, '/') || '/'))\n         ORDER BY v.id DESC LIMIT 1) AS ventana_id,\n       EXISTS (SELECT 1 FROM notificaciones n WHERE n.evento_id = e.id) AS ya_notificado,\n       EXISTS (SELECT 1 FROM decisiones d WHERE d.evento_id = e.id) AS ya_decidido\nFROM registros_archivos e\nWHERE e.id = $1 AND e.evento IN ('MODIFICADO', 'CREADO', 'ELIMINADO', 'MOVIDO', 'PERMISOS')",
        "options": {
          "queryReplacement": "={{ [ parseInt($('Aviso del monitor').first().json.body.evento_id, 10) ] }}"
        }
      },
