      "parameters": {
        "jsCode": "// La persona abrió uno de los links (o se cumplieron las 24 h sin respuesta).\nconst m = $('Armar mensaje').first().json;\nconst q = $input.first().json.query || {};\nconst decision = String(q.decision || '');\nconst opcion = m.opciones.find((o) => o.decision === decision);\nreturn [{ json: {\n  evento_id: m.evento_id,\n  decision,\n  respondio: decision !== '',\n  valida: !!opcion,\n  etiqueta: opcion ? opcion.etiqueta : '',\n  texto_sin_respuesta: `⌛ Pasaron 24 h sin decisión sobre el evento #${m.evento_id} (${m.nombre_archivo}). ` +\n    'Queda como lo dejó el monitor. Para restaurar a mano: python restaurar.py <ruta>.',\n} }];\n"
