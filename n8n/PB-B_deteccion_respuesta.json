        "query": "SELECT d.id AS decision_id, d.decision, d.decidido_por, d.canal,\n       x.resultado, x.detalle, r.id AS evento_id, r.evento, r.nombre_archivo, r.ruta_completa\nFROM ejecuciones x\nJOIN decisiones d ON d.id = x.decision_id\nJOIN registros_archivos r ON r.id = d.evento_id\nWHERE d.id = $1",
