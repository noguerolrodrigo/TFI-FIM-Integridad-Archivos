    {
      "parameters": {
        "jsCode": "// Telegram manda un \"update\". Solo interesan los toques de botones (callback_query); el resto se ignora.\nconst update = $('Toque en Telegram').first().json.body || {};\nconst toque = update.callback_query;\nif (!toque) return [];\n\nconst etiquetas = { INCIDENTE: 'Fue un incidente', AUTORIZADO: 'Era un cambio autorizado',\n                    RESTAURAR: 'Restaurar', ACEPTAR: 'Aceptar cambio' };\nconst datos = String(toque.data || '');\nconst partes = /^(INCIDENTE|AUTORIZADO|RESTAURAR|ACEPTAR):(\\d+)$/.exec(datos);\nconst de = toque.from || {};\nconst usuario = de.username ? '@' + de.username : [de.first_name, de.last_name].filter(Boolean).join(' ');\nreturn [{ json: {\n  consulta_id: String(toque.id || ''),\n  remitente_id: de.id === undefined ? '' : String(de.id),\n  remitente_usuario: usuario,\n  decidido_por: usuario || `id ${de.id}`,\n  datos,\n  valido: !!partes,\n  decision: partes ? partes[1] : '',\n  evento_id: partes ? Number(partes[2]) : null,\n  etiqueta: partes ? etiquetas[partes[1]] : '',\n} }];\n"
      },
      "id": "658c6863-813f-59b7-9310-dc893475aa08",
      "name": "Leer toque",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
